# ── RentPe Environment Variables Example ─────────────────────────────────────
# Copy this file to .env and fill in your real values.
# Never commit the actual .env file to source control.

# ── Database ──────────────────────────────────────────────────────────────────
RENTPE_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET="your-strong-jwt-secret-here"

# ── App URLs ──────────────────────────────────────────────────────────────────
# CRITICAL FOR PRODUCTION: Set this to your CUSTOM DOMAIN (e.g. https://www.rentpe.com)
# DO NOT rely on Vercel's auto-generated NEXT_PUBLIC_VERCEL_URL for email links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID="rzp_test_XXXXXXXXXXXX"
RAZORPAY_KEY_SECRET="your-razorpay-secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_XXXXXXXXXXXX"
# Get webhook secret from Razorpay Dashboard → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"

# ── Sentry ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ── Cron ──────────────────────────────────────────────────────────────────────
CRON_SECRET="your-cron-secret"

# ── PostHog ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY="your_posthog_key"
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ── Upstash Redis ─────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ── SEO / Social ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER="919999999999"

# ── GST & Invoicing ───────────────────────────────────────────────────────────
RENTPE_GSTIN="PENDING REGISTRATION"
RENTPE_SAC_COMMISSION="997312"
RENTPE_SAC_ONBOARDING="998314"

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="RentPe <onboarding@resend.dev>"
EMAIL_OTP_ENABLED="true"

# ── Field Encryption ─────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER change this key once data is encrypted without a re-encryption migration.
FIELD_ENCRYPTION_KEY="your-32-byte-hex-key"

# ─────────────────────────────────────────────────────────────────────────────
# PHASE 1 FREE DIRECT AUTOMATIONS
# ─────────────────────────────────────────────────────────────────────────────

# ── Slack Webhooks ────────────────────────────────────────────────────────────
# Setup: https://api.slack.com/apps → Create App → Incoming Webhooks
#   1. Create a new Slack App (or use an existing one)
#   2. Enable "Incoming Webhooks" under Features
#   3. Click "Add New Webhook to Workspace" and pick your #rentpe-alerts channel
#   4. Copy the Webhook URL below
SLACK_WEBHOOK_URL=

# ── Google Sheets (via Google Apps Script — FREE, zero external dependencies) ─
# Setup:
#   1. Open your Google Sheet → Extensions → Apps Script
#   2. Paste and deploy the doPost() script (see src/lib/sheets.ts for the full code)
#   3. Deploy as a Web App: Execute as "Me", Access "Anyone"
#   4. Copy the Web App URL below
# Columns appended: Date | Booking ID | Student Name | Property Name | Amount (₹) | Type
GOOGLE_SHEET_WEBHOOK_URL=

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("RENTPE_DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String               @id @default(uuid())
  email                  String               @unique
  emailVerified          Boolean              @default(false)
  emailVerificationToken String?              @unique
  passwordHash           String
  role                   String               @default("USER")
  roles                  String[]             @default(["USER"])
  primaryRole            String               @default("USER")
  adminRole              String?
  isStudent              Boolean              @default(false)
  isOwner                Boolean              @default(false)
  isAdmin                Boolean              @default(false)
  isOnboarder            Boolean              @default(false)
  isVerifier             Boolean              @default(false)
  name                   String?
  phone                  String?
  phoneVerified          Boolean              @default(false)
  city                   String?
  status                 String               @default("PENDING_VERIFICATION")
  loyaltyPoints          Int                  @default(0)
  lastLoginAt            DateTime?            @default(now())
  lastLoginIp            String?
  bannedReason           String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  displayId              String?              @unique
  deletedAt              DateTime?
  razorpayAccountId      String?
  commissionRate         Float?
  resetToken             String?
  resetTokenExpiry       DateTime?
  businessName           String?
  profilePhoto           String?
  dateOfBirth            String?
  gender                 String?
  emergencyContact       String?
  currentAddress         String?
  college                String?
  occupationType         String?
  occupationDetail       String?
  bio                    String?
  notifPrefs             String               @default("{\"bookings\":true,\"kyc\":true,\"messages\":true,\"disputes\":true}")
  deactivationRequested  Boolean              @default(false)
  deactivationReason     String?
  parentOwnerId          String?
  staffPermissions       String?
  twoFactorSecret        String?
  twoFactorEnabled       Boolean              @default(false)
  applicationId          String?              @unique
  termsAccepted          Boolean              @default(false)
  termsAcceptedAt        DateTime?
  termsVersion           String?
  passwordResetExpiry    DateTime?
  passwordResetToken     String?
  actionNotes            ActionNote[]         @relation("TargetUser")
  auditLogs              AuditLog[]           @relation("PerformedBy")
  bookings               Booking[]
  fraudAlerts            FraudAlert[]
  loginLogs              LoginLog[]
  receivedMessages       Message[]            @relation("ReceivedMessages")
  sentMessages           Message[]            @relation("SentMessages")
  notifications          Notification[]
  ownerOnboardings       OwnerOnboarding[]    @relation("OnboardedBy")
  properties             Property[]
  roleUpgradeRequests    RoleUpgradeRequest[]
  savedProperties        SavedProperty[]
  tenancies              Tenancy[]
  tickets                Ticket[]
  ticketMessages         TicketMessage[]      @relation("TicketMessageSender")
  parentOwner            User?                @relation("OwnerToStaff", fields: [parentOwnerId], references: [id])
  staffMembers           User[]               @relation("OwnerToStaff")
  sessions               UserSession[]
  adminProfile           AdminEmployee?       @relation("UserAsAdminEmployee")
  drafts                 Draft[]
  foodPreferences        FoodPreference[]
  fraudFlags             FraudFlag[]
  linkedAsA              LinkedAccount[]      @relation("UserA")
  linkedAsB              LinkedAccount[]      @relation("UserB")
  ownerEmployees         OwnerEmployee[]      @relation("OwnerEmployees")
  employeeProfile        OwnerEmployee?       @relation("UserAsEmployee")
  uploadSessions         UploadSession[]
  fingerprints           UserFingerprint[]
}

model RoleUpgradeRequest {
  id             String    @id @default(uuid())
  userId         String
  requestedRole  String    @default("OWNER")
  status         String    @default("PENDING")
  reason         String?
  propertyType   String?
  estimatedRooms Int?
  adminNote      String?
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id])
}

model Property {
  id                         String                       @id @default(uuid())
  displayId                  String?                      @unique
  ownerId                    String
  name                       String
  address                    String
  city                       String
  description                String?
  rules                      String?
  amenities                  String
  images                     String
  status                     String                       @default("PENDING_VERIFICATION")
  adminNotes                 String?
  pgPhotoUrl                 String?
  aadhaarProof               String?
  panProof                   String?
  pgLicenceUrl               String?
  buildingPhotos             String?
  commonAreaPhotos           String?
  parkingPhotos              String?
  roomsAndBathroomPhotos     String?
  livePhotoUrl               String?
  exteriorPhotos             String?
  interiorPhotos             String?
  roomsPhotos                String?
  hallPhotos                 String?
  lobbyPhotos                String?
  washroomPhotos             String?
  amenitiesPhotos            String?
  verifiedDocs               String                       @default("[]")
  averageRating              Float                        @default(0)
  reviewCount                Int                          @default(0)
  propertyType               String                       @default("PG")
  genderType                 String                       @default("COED")
  latitude                   Float?
  longitude                  Float?
  cancellationPolicy         String?
  noticePeriod               Int?
  refundPolicy               String?
  bankAccountNo              String?
  bankIfsc                   String?
  bankName                   String?
  videoUrl                   String?
  isVerified                 Boolean                      @default(false)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  ownerName                  String?
  businessName               String?
  pgLicence                  String?
  licenseNumber              String?
  reraId                     String?
  termsAccepted              Boolean                      @default(false)
  termsAcceptedAt            DateTime?
  feeTermsAccepted           Boolean                      @default(false)
  feeTermsAcceptedAt         DateTime?
  onboardingPaidAt           DateTime?
  onboardingPaymentMethod    String?
  applicationId              String?                      @unique
  foodType                   String                       @default("NOT_AVAILABLE")
  foodPricePerMonth          Float?
  deactivationRequestedAt    DateTime?
  deactivationReason         String?
  deactivationRejectedAt     DateTime?
  deactivationRejectedBy     String?
  deactivationRejectedReason String?
  deletedAt                  DateTime?
  bookings                   Booking[]
  foodMenu                   FoodMenu[]
  owner                      User                         @relation(fields: [ownerId], references: [id])
  reviews                    Review[]
  rooms                      Room[]
  savedBy                    SavedProperty[]
  tenancies                  Tenancy[]
  tenants                    Tenant[]
  tickets                    Ticket[]
  employeeAssignments        EmployeePropertyAssignment[]
  foodPreferences            FoodPreference[]
  vacatingNotices            VacatingNotice[]
  maintenanceRequests        MaintenanceRequest[]
  minimumNoticeDays          Int                          @default(30)
}

model Room {
  id            String    @id @default(uuid())
  displayId     String?   @unique
  propertyId    String
  roomNumber    String
  type          String
  price         Float
  availability  Int
  totalBeds     Int       @default(1)
  status        String    @default("AVAILABLE")
  photoUrl      String?
  depositMonths Int       @default(1)
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?
  updatedAt     DateTime  @updatedAt
  beds              Bed[]
  bookings          Booking[]
  property          Property  @relation(fields: [propertyId], references: [id])
  tenants           Tenant[]
  currentRoomReqs   RoomChangeRequest[] @relation("CurrentRoom")
  requestedRoomReqs RoomChangeRequest[] @relation("RequestedRoom")
}

model Bed {
  id                String    @id @default(uuid())
  displayId         String?   @unique
  roomId            String
  bedNumber         String
  status            String    @default("AVAILABLE")
  lockedByBookingId String?
  lockedAt          DateTime?
  lockExpiresAt     DateTime?
  currentBookingId  String?
  tenantId          String?   @unique
  maintenanceReason String?
  maintenanceSince  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  room              Room      @relation(fields: [roomId], references: [id])
  tenant            Tenant?
}

model Booking {
  id                          String           @id @default(uuid())
  displayId                   String           @unique
  userId                      String
  propertyId                  String?
  roomId                      String?
  propertyName                String
  occupancy                   String
  originalOccupancy           String?
  guestName                   String
  guestEmail                  String?
  guestPhone                  String?
  guestAddress                String?
  onboardingDate              String?
  moveInDate                  String
  stayDuration                Int?
  occupants                   Int?             @default(1)
  message                     String?
  status                      String           @default("APPLIED")
  appliedAt                   DateTime?
  approvedAt                  DateTime?
  moveInScheduled             DateTime?
  moveInAt                    DateTime?
  activeAt                    DateTime?
  vacatingAt                  DateTime?
  completedAt                 DateTime?
  rejectedAt                  DateTime?
  paymentStatus               String           @default("UNPAID")
  paymentMethod               String?
  paidAt                      DateTime?
  amount                      Float
  roomAssigned                String?
  fraudRiskScore              Int              @default(0)
  isFraudBlocked              Boolean          @default(false)
  agreementSigned             Boolean          @default(false)
  agreementSignedAt           DateTime?
  tenantId                    String?          @unique
  tokenAmount                 Float?           @default(1000)
  tokenPaidAt                 DateTime?
  tokenPaymentId              String?
  reservationExpiresAt        DateTime?
  kycVerifiedAt               DateTime?
  kycRejectedAt               DateTime?
  kycNotes                    String?
  rejectionReason             String?
  cancelReason                String?
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @updatedAt
  deletedAt                   DateTime?
  guestCity                   String?
  guestCountry                String?          @default("India")
  guestPincode                String?
  occupationDetail            String?
  occupationType              String?
  pendingAmount               Float?
  depositAmount               Float?
  depositMonths               Int?
  platformFeeAmount           Float?
  propertyAgreementAccepted   Boolean          @default(false)
  propertyAgreementAcceptedAt DateTime?
  foodSelected                Boolean          @default(false)
  foodPriceApplied            Float            @default(0)
  property                    Property?        @relation(fields: [propertyId], references: [id])
  room                        Room?            @relation(fields: [roomId], references: [id])
  user                        User             @relation(fields: [userId], references: [id])
  payments                    Payment[]
  platformFee                 PlatformFee?
  invoices                    RentInvoice[]    @relation("BookingInvoices")
  tenant                      Tenant?
  documents                   TenantDocument[]
  creditNotes                 CreditNote[]
  foodPreferences             FoodPreference[]
  fraudFlags                  FraudFlag[]
  moveInChecklist             MoveInChecklist?
  vacatingNotices             VacatingNotice[]
  roomChangeRequests          RoomChangeRequest[]
  maintenanceRequests         MaintenanceRequest[]
}


model Waitlist {
  id         String    @id @default(uuid())
  userId     String
  propertyId String
  roomType   String?
  occupancy  String?
  guestName  String
  guestPhone String?
  guestEmail String?
  moveInDate String?
  status     String    @default("WAITING")
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Tenant {
  id                  String            @id @default(uuid())
  displayId           String            @unique
  studentId           String
  bookingId           String?           @unique
  propertyId          String
  roomId              String
  bedId               String?           @unique
  name                String
  phone               String
  email               String?
  roomNumber          String
  roomType            String
  rent                Float
  startDate           String
  expectedMoveOutDate String?
  actualMoveOutDate   String?
  status              String            @default("UPCOMING_MOVE_IN")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  vacateNote          String?
  address             String?
  city                String?
  country             String?           @default("India")
  occupationDetail    String?
  occupationType      String?
  pincode             String?
  applicationId       String?
  attendances         Attendance[]
  billingProfile      BillingProfile?
  disputes            Dispute[]
  moveOutRequests     MoveOutRequest[]
  rentRecords         RentRecord[]
  reviews             Review[]
  settlementRecord    SettlementRecord?
  bed                 Bed?              @relation(fields: [bedId], references: [id])
  booking             Booking?          @relation(fields: [bookingId], references: [id])
  property            Property          @relation(fields: [propertyId], references: [id])
  room                Room              @relation(fields: [roomId], references: [id])
}

model BillingProfile {
  id               String           @id @default(uuid())
  tenantId         String           @unique
  propertyId       String
  roomId           String
  bedId            String?
  monthlyRent      Float
  securityDeposit  Float
  billingDay       Int              @default(1)
  billingAnchorDay Int              @default(1)
  status           String           @default("ACTIVE")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  invoices         RentInvoice[]
  deposit          SecurityDeposit?
}

model RentInvoice {
  id               String         @id @default(uuid())
  displayId        String         @unique
  billingProfileId String
  tenantId         String
  propertyId       String
  month            String
  billingMonth     String?
  bookingId        String?
  amount           Float
  rentAmount       Float          @default(0)
  foodAmount       Float          @default(0)
  foodProrated     Boolean        @default(false)
  foodNotes        String?
  lockedAt         DateTime?
  creditApplied    Float          @default(0)
  dueDate          DateTime
  status           String         @default("PENDING")
  paidAmount       Float          @default(0)
  paidRentAmount   Float          @default(0)
  paidFoodAmount   Float          @default(0)
  paidAt           DateTime?
  paymentMethod    String?        // ONLINE | CASH | BANK_TRANSFER
  confirmedBy      String?        // userId of who confirmed
  confirmedByName  String?        // display name
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  payments         Payment[]      @relation("InvoicePayments")
  billingProfile   BillingProfile @relation(fields: [billingProfileId], references: [id])
  booking          Booking?       @relation("BookingInvoices", fields: [bookingId], references: [id])
  reminders        RentReminder[]

  @@unique([tenantId, billingMonth])
}


model SecurityDeposit {
  id               String         @id @default(uuid())
  billingProfileId String         @unique
  tenantId         String
  amount           Float
  status           String         @default("PENDING")
  paidAt           DateTime?
  refundStatus     String?
  refundAmount     Float?
  deductionAmount  Float?
  deductionReason  String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  payments         Payment[]      @relation("DepositPayments")
  billingProfile   BillingProfile @relation(fields: [billingProfileId], references: [id])
}

model SettlementRecord {
  id               String   @id @default(uuid())
  tenantId         String   @unique
  finalRentPending Float
  utilityCharges   Float    @default(0)
  damageDeductions Float    @default(0)
  depositRefunded  Float
  settlementDate   DateTime @default(now())
  notes            String?
  createdAt        DateTime @default(now())
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
}

model TenantHistory {
  id               String   @id @default(uuid())
  tenantId         String
  studentId        String
  propertyName     String
  roomNumber       String
  bedNumber        String
  moveInDate       DateTime
  moveOutDate      DateTime
  stayDurationDays Int
  totalPaid        Float
  createdAt        DateTime @default(now())
}

model Attendance {
  id         String @id @default(uuid())
  tenantId   String
  propertyId String
  date       String
  status     String @default("PRESENT")
  mealType   String @default("GENERAL")
  tenant     Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, date, mealType])
}

model MoveOutRequest {
  id            String    @id @default(uuid())
  tenantId      String
  requestedBy   String
  requestedDate String
  reason        String?
  status        String    @default("PENDING")
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
}

model Review {
  id         String   @id @default(uuid())
  propertyId String
  tenantId   String
  rating     Int
  comment    String?
  status     String   @default("PUBLISHED")
  adminNotes String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  property   Property @relation(fields: [propertyId], references: [id])
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([propertyId, tenantId])
}

model RentRecord {
  id        String   @id @default(uuid())
  tenantId  String
  month     String
  amount    Float
  paid      Boolean  @default(false)
  paidOn    String?
  note      String?  // e.g. "Prorated — move-in 18 Jun 2025"
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
}

model FoodRecord {
  id         String   @id @default(cuid())
  bookingId  String
  propertyId String
  userId     String
  month      String   // "Jun 2025"
  amount     Float
  paid       Boolean  @default(false)
  note       String?
  createdAt  DateTime @default(now())
}

model Payment {
  id              String           @id @default(uuid())
  bookingId       String
  invoiceId       String?
  depositId       String?
  amount          Float
  method          String
  status          String           @default("PENDING")
  razorpayOrderId String?
  razorpayId      String?
  verifiedBy      String?
  date            DateTime         @default(now())
  booking         Booking          @relation(fields: [bookingId], references: [id])
  deposit         SecurityDeposit? @relation("DepositPayments", fields: [depositId], references: [id])
  invoice         RentInvoice?     @relation("InvoicePayments", fields: [invoiceId], references: [id])
}

model FoodMenu {
  id          String   @id @default(uuid())
  propertyId  String
  dayOfWeek   String
  mealType    String
  items       String
  weeklyMenu  String   @default("{}") // JSON: { monday: { breakfast: "", lunch: "", dinner: "" }, ... }
  updatedBy   String?
  menuVersion Int      @default(0)
  property    Property @relation(fields: [propertyId], references: [id])
}

model FoodPreference {
  id                String    @id @default(uuid())
  bookingId         String
  propertyId        String
  userId            String
  foodSelected      Boolean
  changedBy         String
  changedById       String
  effectiveFrom     DateTime
  notes             String?
  status            String    @default("CONFIRMED")
  confirmationToken String?   @unique
  tokenExpiry       DateTime?
  tokenUsed         Boolean   @default(false)
  confirmedAt       DateTime?
  createdAt         DateTime  @default(now())
  booking           Booking   @relation(fields: [bookingId], references: [id])
  property          Property  @relation(fields: [propertyId], references: [id])
  user              User      @relation(fields: [userId], references: [id])

  @@unique([bookingId, effectiveFrom])
  @@index([bookingId])
  @@index([userId])
  @@map("food_preferences")
}

model Ticket {
  id           String          @id @default(uuid())
  displayId    String          @unique
  userId       String
  propertyId   String?
  bookingId    String?
  category     String
  title        String          @default("")
  status       String          @default("OPEN")
  priority     String          @default("MEDIUM")
  assignedTo   String?
  targetTeam   String          @default("ADMIN")
  raisedByRole String          @default("USER")
  description  String
  replies      String?
  photos       String          @default("[]")
  ownerNote    String?
  adminNote    String?
  resolvedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  property     Property?       @relation(fields: [propertyId], references: [id])
  user         User            @relation(fields: [userId], references: [id])
  messages     TicketMessage[]
}

model TicketMessage {
  id         String   @id @default(uuid())
  ticketId   String
  senderId   String
  senderRole String
  senderName String
  message    String
  createdAt  DateTime @default(now())
  ticket     Ticket   @relation(fields: [ticketId], references: [id])
  sender     User     @relation("TicketMessageSender", fields: [senderId], references: [id])
}


model Notification {
  id             String   @id @default(uuid())
  userId         String
  type           String
  category       String?
  message        String
  isRead         Boolean  @default(false)
  isPersistent   Boolean  @default(false)
  targetRole     String   @default("USER")
  metadata       String?
  recipientEmail String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])
}

model AuditLog {
  id            String   @id @default(uuid())
  actorId       String
  actorRole     String
  actorName     String
  actionType    String
  entityType    String
  entityId      String
  entityName    String?
  description   String
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())
  actor         User     @relation("PerformedBy", fields: [actorId], references: [id])
}

model ActionNote {
  id           String   @id @default(uuid())
  targetUserId String?
  targetType   String
  targetId     String
  action       String
  reason       String
  performedBy  String
  timestamp    DateTime @default(now())
  targetUser   User?    @relation("TargetUser", fields: [targetUserId], references: [id])
}

model TenantDocument {
  id           String    @id @default(uuid())
  bookingId    String
  type         String
  fileData     String
  fileName     String?
  status       String    @default("PENDING")
  rejectedNote String?
  uploadedAt   DateTime  @default(now())
  verifiedAt   DateTime?
  verifiedBy   String?
  auditTrail   String    @default("[]")
  booking      Booking   @relation(fields: [bookingId], references: [id])
}

model TeamMember {
  id          String   @id @default(uuid())
  displayId   String   @unique
  name        String
  email       String
  phone       String?
  role        String
  permissions String
  status      String   @default("ACTIVE")
  addedOn     DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OwnerStaff {
  id           String   @id @default(uuid())
  displayId    String   @unique
  ownerId      String
  name         String
  email        String
  phone        String?
  designation  String
  permissions  String
  status       String   @default("ACTIVE")
  addedOn      DateTime @default(now())
  updatedAt    DateTime @updatedAt
  addressProof String?
  idProof      String?
  photo        String?
  staffAddress String?
}

model PlatformSettings {
  id                       String   @id @default("singleton")
  feesEnabled              Boolean  @default(false)
  studentRentFeeFlat       Float    @default(9)
  ownerRentFeeFlat         Float    @default(9)
  ownerOnboardingFeeFlat   Float    @default(99)
  platformWalletBalance    Float    @default(0)
  globalCommissionRate     Float    @default(10)
  kycRequired              Boolean  @default(true)
  tokenPaymentRequired     Boolean  @default(true)
  maxBookingsPerStudentDay Int      @default(3)
  maxListingsPerOwnerDay   Int      @default(3)
  reservationWindowMins    Int      @default(10)
  maintenanceMode          Boolean  @default(false)
  maintenanceMessage       String?
  updatedAt                DateTime @updatedAt
}

model PlatformFee {
  id             String    @id @default(uuid())
  bookingId      String    @unique
  grossAmount    Float
  customerFee    Float
  totalCharged   Float
  ownerNet       Float
  ownerFee       Float
  platformEarned Float
  status         String    @default("ACTIVE")
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  booking        Booking   @relation(fields: [bookingId], references: [id])
}

model FeeExemption {
  id             String    @id @default(uuid())
  userId         String?
  propertyName   String?
  exemptCustomer Boolean   @default(false)
  exemptOwner    Boolean   @default(false)
  reason         String
  status         String    @default("ACTIVE")
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
}

model OwnerOnboarding {
  id                String    @id @default(uuid())
  displayId         String    @unique
  source            String
  ownerName         String
  ownerEmail        String
  ownerPhone        String
  buildingName      String
  address           String
  city              String
  pincode           String
  country           String    @default("India")
  pgLicenceNumber   String?
  notes             String?
  idProofData       String?
  idProofName       String?
  pgLicenceData     String?
  pgLicenceName     String?
  buildingImageData String?
  buildingImageName String?
  additionalPhotos  String    @default("[]")
  status            String    @default("PENDING_ONBOARDING")
  submittedById     String?
  onboardedById     String?
  verifiedById      String?
  onboardedAt       DateTime?
  verifiedAt        DateTime?
  rejectedReason    String?
  auditTrail        String    @default("[]")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  onboardedBy       User?     @relation("OnboardedBy", fields: [onboardedById], references: [id])
}

model Employee {
  id                     String    @id @default(uuid())
  displayId              String    @unique
  name                   String
  email                  String    @unique
  phone                  String
  dateOfBirth            String?
  gender                 String?
  permanentAddress       String?
  currentAddress         String?
  emergencyContactName   String?
  emergencyContactPhone  String?
  emergencyContactRel    String?
  department             String
  designation            String
  permissions            String    @default("[]")
  joiningDate            DateTime?
  salary                 Float?
  employmentType         String    @default("FULL_TIME")
  aadhaarNumber          String?
  aadhaarDoc             String?
  aadhaarName            String?
  panNumber              String?
  panDoc                 String?
  panName                String?
  photo                  String?
  photoName              String?
  educationCert          String?
  educationCertName      String?
  experienceLetter       String?
  experienceLetterName   String?
  policeVerification     String?
  policeVerificationName String?
  addressProof           String?
  addressProofName       String?
  aadhaarVerified        Boolean   @default(false)
  panVerified            Boolean   @default(false)
  educationVerified      Boolean   @default(false)
  addressVerified        Boolean   @default(false)
  policeVerified         Boolean   @default(false)
  backgroundCheckStatus  String    @default("PENDING")
  backgroundCheckNotes   String?
  backgroundCheckedAt    DateTime?
  status                 String    @default("PENDING_DOCS")
  rejectedReason         String?
  suspensionReason       String?
  terminatedReason       String?
  auditTrail             String    @default("[]")
  addedById              String?
  addedOn                DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  empCode                String?   @unique
  empCodeNotes           String?
}

model OwnerPayout {
  id               String    @id @default(uuid())
  displayId        String    @unique
  ownerId          String
  propertyId       String?
  period           String
  grossAmount      Float
  commissionAmount Float
  netAmount        Float
  bookingIds       String    @default("[]")
  status           String    @default("PENDING")
  paymentMode      String?
  bankAccountNo    String?
  bankIfsc         String?
  txnReference     String?
  notes            String?
  scheduledFor     DateTime?
  paidAt           DateTime?
  approvedBy       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Dispute {
  id           String    @id @default(uuid())
  displayId    String    @unique
  tenantId     String?
  bookingId    String?
  propertyId   String?
  raisedById   String
  againstUser  String?
  raisedByRole String    @default("USER")
  type         String
  subject      String
  title        String?
  description  String
  evidenceData String?
  evidenceName String?
  status       String    @default("OPEN")
  priority     String    @default("MEDIUM")
  resolution   String?
  resolvedById String?
  resolvedAt   DateTime?
  adminNotes   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tenant       Tenant?   @relation(fields: [tenantId], references: [id])
  messages     DisputeMessage[]
}

model BookingEvent {
  id              String   @id @default(uuid())
  bookingId       String
  eventType       String
  title           String
  description     String?
  performedBy     String?
  performedByRole String?
  metadata        String   @default("{}")
  createdAt       DateTime @default(now())
}

model FraudAlert {
  id             String   @id @default(uuid())
  userId         String
  type           String
  severity       String   @default("MEDIUM")
  targetId       String
  targetType     String
  description    String
  metadata       String   @default("{}")
  status         String   @default("OPEN")
  investigatedBy String?
  resolution     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id])
}

model SystemEvent {
  id        String   @id @default(uuid())
  type      String
  severity  String   @default("INFO")
  message   String
  userId    String?
  ipAddress String?
  path      String?
  metadata  String   @default("{}")
  createdAt DateTime @default(now())
}

model LoginLog {
  id         String   @id @default(uuid())
  userId     String
  userRole   String
  adminRole  String?
  success    Boolean
  ipAddress  String?
  userAgent  String?
  failReason String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model RateLimit {
  id          String   @id @default(uuid())
  key         String   @unique
  action      String
  count       Int      @default(1)
  windowStart DateTime @default(now())
  windowEnd   DateTime
  updatedAt   DateTime @updatedAt
}

model AdminPermission {
  id         String   @id @default(uuid())
  adminId    String
  permission String
  granted    Boolean  @default(true)
  grantedBy  String?
  reason     String?
  createdAt  DateTime @default(now())
}

model SavedProperty {
  id         String    @id @default(uuid())
  userId     String
  propertyId String
  note       String?
  status     String    @default("ACTIVE")
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  property   Property  @relation(fields: [propertyId], references: [id])
  user       User      @relation(fields: [userId], references: [id])

  @@unique([userId, propertyId])
}

model Message {
  id                String    @id @default(uuid())
  bookingId         String?
  propertyId        String?
  threadId          String
  senderId          String
  receiverId        String
  content           String
  attachmentData    String?
  attachmentName    String?
  isRead            Boolean   @default(false)
  readAt            DateTime?
  deletedBySender   Boolean   @default(false)
  deletedByReceiver Boolean   @default(false)
  createdAt         DateTime  @default(now())
  receiver          User      @relation("ReceivedMessages", fields: [receiverId], references: [id])
  sender            User      @relation("SentMessages", fields: [senderId], references: [id])
}

model UserSession {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  ipAddress  String?
  userAgent  String?
  isActive   Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model RefundRecord {
  id           String    @id @default(uuid())
  bookingId    String
  amount       Float
  reason       String
  refundType   String    @default("PARTIAL")
  status       String    @default("PENDING")
  initiatedBy  String
  initiatedAt  DateTime  @default(now())
  processedAt  DateTime?
  processedBy  String?
  txnReference String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model OwnerEmployee {
  id                String                       @id @default(uuid())
  displayId         String                       @unique
  ownerId           String
  name              String
  email             String                       @unique
  phone             String
  role              String                       @default("Staff")
  status            String                       @default("ACTIVE")
  pincode           String?
  city              String?
  state             String?
  postOffice        String?
  address           String?
  invitationToken   String?                      @unique
  invitationExpires DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  userId            String?                      @unique
  assignments       EmployeePropertyAssignment[]
  owner             User                         @relation("OwnerEmployees", fields: [ownerId], references: [id])
  user              User?                        @relation("UserAsEmployee", fields: [userId], references: [id])

  @@map("owner_employees")
}

model EmployeePropertyAssignment {
  id         String        @id @default(uuid())
  employeeId String
  propertyId String
  assignedBy String
  status     String        @default("ACTIVE")
  deletedAt  DateTime?
  assignedAt DateTime      @default(now())
  employee   OwnerEmployee @relation(fields: [employeeId], references: [id])
  property   Property      @relation(fields: [propertyId], references: [id])

  @@unique([employeeId, propertyId])
  @@map("employee_property_assignment")
}

model AdminEmployee {
  id          String   @id @default(uuid())
  displayId   String   @unique
  userId      String?  @unique
  name        String
  email       String   @unique
  phone       String
  department  String
  role        String
  permissions String   @default("[]")
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User?    @relation("UserAsAdminEmployee", fields: [userId], references: [id])

  @@map("admin_employees")
}

model Draft {
  id         String   @id @default(uuid())
  userId     String
  entityType String
  entityId   String?
  data       Json
  status     String   @default("DRAFT")
  lastStep   Int      @default(1)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId, entityType])
  @@map("drafts")
}

model UploadSession {
  id             String   @id @default(uuid())
  userId         String
  fileName       String
  fileSize       Int
  mimeType       String
  totalChunks    Int
  uploadedChunks Int[]    @default([])
  storageKey     String   @unique
  status         String   @default("UPLOADING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id])

  @@map("upload_sessions")
}

model CreditNote {
  id             String   @id @default(uuid())
  displayId      String   @unique
  bookingId      String
  tenantId       String?
  invoiceId      String?
  amount         Float
  carryForward   Float    @default(0)
  reason         String
  type           String
  createdById    String
  createdByRole  String
  appliedToMonth String?
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  booking        Booking  @relation(fields: [bookingId], references: [id])

  @@index([bookingId, status, createdAt])
  @@map("credit_notes")
}

model FraudFlag {
  id        String   @id @default(uuid())
  userId    String
  bookingId String?
  reason    String
  riskScore Int      @default(0)
  status    String   @default("OPEN")
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  booking   Booking? @relation(fields: [bookingId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([bookingId])
  @@map("fraud_flags")
}

model UserFingerprint {
  id         String   @id @default(uuid())
  userId     String
  deviceHash String?
  ipAddress  String
  userAgent  String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([deviceHash])
  @@map("user_fingerprints")
}

model LinkedAccount {
  id              String   @id @default(uuid())
  userAId         String
  userBId         String
  linkType        String
  reason          String
  confidenceScore Int      @default(0)
  createdAt       DateTime @default(now())
  userA           User     @relation("UserA", fields: [userAId], references: [id])
  userB           User     @relation("UserB", fields: [userBId], references: [id])

  @@unique([userAId, userBId, linkType])
  @@index([userAId])
  @@index([userBId])
  @@map("linked_accounts")
}

model IdCounter {
  id        String   @id @default(cuid())
  type      String
  fyKey     String   @default("GLOBAL")
  sequence  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([type, fyKey])
}

model Tenancy {
  id            String    @id @default(cuid())
  userId        String
  propertyId    String
  tenancyNumber Int
  displayId     String    @unique
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  property      Property  @relation(fields: [propertyId], references: [id])
  user          User      @relation(fields: [userId], references: [id])

  @@unique([userId, tenancyNumber])
}

// ─────────────────────────────────────────────────────────
// PHASE 1 TENANT FEATURES
// ─────────────────────────────────────────────────────────

model MoveInChecklist {
  id          String    @id @default(cuid())
  bookingId   String    @unique
  userId      String
  items       String    @default("[]") // JSON array of checklist items
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  booking     Booking   @relation(fields: [bookingId], references: [id])

  @@map("move_in_checklists")
}

model VacatingNotice {
  id             String    @id @default(cuid())
  displayId      String    @unique
  bookingId      String
  tenancyId      String?
  userId         String
  propertyId     String
  ownerId        String
  plannedMoveOut DateTime
  reason         String
  status         String    @default("SUBMITTED") // SUBMITTED, ACKNOWLEDGED, APPROVED, DISPUTED, WITHDRAWN
  ownerNote      String?
  submittedAt    DateTime  @default(now())
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  booking        Booking   @relation(fields: [bookingId], references: [id])
  property       Property  @relation(fields: [propertyId], references: [id])

  @@index([userId])
  @@index([propertyId])
  @@map("vacating_notices")
}

model RoomChangeRequest {
  id              String    @id @default(cuid())
  displayId       String    @unique
  bookingId       String
  userId          String
  currentRoomId   String
  requestedRoomId String?   // null = any available room
  reason          String
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED, COMPLETED
  ownerNote       String?
  preferredDate   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  booking         Booking   @relation(fields: [bookingId], references: [id])
  currentRoom     Room      @relation("CurrentRoom", fields: [currentRoomId], references: [id])
  requestedRoom   Room?     @relation("RequestedRoom", fields: [requestedRoomId], references: [id])

  @@index([userId])
  @@index([bookingId])
  @@map("room_change_requests")
}

model MaintenanceRequest {
  id          String    @id @default(cuid())
  displayId   String    @unique
  bookingId   String
  userId      String
  propertyId  String
  category    String    // ELECTRICAL, PLUMBING, FURNITURE, CLEANLINESS, WIFI, SECURITY, OTHER
  title       String
  description String
  photos      String    @default("[]") // JSON array of Cloudinary URLs
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status      String    @default("OPEN") // OPEN, ACKNOWLEDGED, IN_PROGRESS, RESOLVED, CLOSED
  ownerNote   String?
  resolvedAt  DateTime?
  slaDeadline DateTime? // Computed from priority on creation
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  booking     Booking   @relation(fields: [bookingId], references: [id])
  property    Property  @relation(fields: [propertyId], references: [id])

  @@index([userId])
  @@index([propertyId])
  @@index([status])
  @@map("maintenance_requests")
}

model RentReminder {
  id        String   @id @default(cuid())
  invoiceId String
  userId    String
  type      String   // 7_DAYS_BEFORE, 3_DAYS_BEFORE, DUE_TODAY, OVERDUE_1_DAY, OVERDUE_3_DAYS, OVERDUE_7_DAYS
  sentAt    DateTime @default(now())
  channel   String   // EMAIL, NOTIFICATION

  invoice   RentInvoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId, type])
  @@map("rent_reminders")
}

// ─────────────────────────────────────────────────────────
// ADMIN PHASE 2 MODELS
// ─────────────────────────────────────────────────────────

model DisputeMessage {
  id          String   @id @default(cuid())
  disputeId   String
  senderId    String
  senderRole  String   // "USER", "OWNER", "ADMIN"
  message     String
  attachments String   @default("[]")
  createdAt   DateTime @default(now())

  dispute     Dispute  @relation(fields: [disputeId], references: [id])

  @@index([disputeId])
  @@map("dispute_messages")
}

model ServiceCity {
  id          String   @id @default(cuid())
  name        String   @unique  // "Delhi", "Bangalore"
  slug        String   @unique  // "delhi", "bangalore"
  state       String
  isActive    Boolean  @default(true)
  pinCodes    String   @default("[]") // JSON array of pin codes
  priority    Int      @default(0)    // Higher = appears first in search
  metaTitle   String?               // For SEO
  metaDesc    String?               // For SEO
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("service_cities")
}

model CommissionConfig {
  id           String   @id @default(cuid())
  propertyType String   // "PG", "HOSTEL", "FLAT", "DEFAULT"
  feePercent   Float    @default(5.0)
  flatFee      Float?   // Optional flat fee instead of %
  effectiveFrom DateTime @default(now())
  createdBy    String
  isActive     Boolean  @default(true)
  notes        String?
  createdAt    DateTime @default(now())

  @@map("commission_configs")
}


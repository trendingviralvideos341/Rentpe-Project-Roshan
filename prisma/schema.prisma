generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("RENTPE_DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String            @id @default(uuid())
  email                 String            @unique
  passwordHash          String
  role                  String            @default("USER")
  roles                 String            @default("USER")
  adminRole             String?
  isStudent             Boolean           @default(false)
  isOwner               Boolean           @default(false)
  isAdmin               Boolean           @default(false)
  isOnboarder           Boolean           @default(false)
  isVerifier            Boolean           @default(false)
  name                  String?
  phone                 String?
  status                String            @default("ACTIVE")
  loyaltyPoints         Int               @default(0)
  lastLoginAt           DateTime?         @default(now())
  lastLoginIp           String?
  bannedReason          String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  displayId             String?           @unique
  deletedAt             DateTime?
  razorpayAccountId     String?
  commissionRate        Float?
  resetToken            String?
  resetTokenExpiry      DateTime?
  businessName          String?
  profilePhoto          String?
  dateOfBirth           String?
  gender                String?
  emergencyContact      String?
  currentAddress        String?
  college               String?
  occupationType        String?
  occupationDetail      String?
  bio                   String?
  notifPrefs            String            @default("{\"bookings\":true,\"kyc\":true,\"messages\":true,\"disputes\":true}")
  deactivationRequested Boolean           @default(false)
  deactivationReason    String?
  parentOwnerId         String?
  staffPermissions      String?
  twoFactorSecret       String?
  twoFactorEnabled      Boolean           @default(false)
  actionNotes           ActionNote[]      @relation("TargetUser")
  auditLogs             AuditLog[]        @relation("PerformedBy")
  bookings              Booking[]
  fraudAlerts           FraudAlert[]
  loginLogs             LoginLog[]
  receivedMessages      Message[]         @relation("ReceivedMessages")
  sentMessages          Message[]         @relation("SentMessages")
  notifications         Notification[]
  ownerOnboardings      OwnerOnboarding[] @relation("OnboardedBy")
  properties            Property[]
  savedProperties       SavedProperty[]
  tickets               Ticket[]
  parentOwner           User?             @relation("OwnerToStaff", fields: [parentOwnerId], references: [id])
  staffMembers          User[]            @relation("OwnerToStaff")
  sessions              UserSession[]
}

model Property {
  id                     String          @id @default(uuid())
  ownerId                String
  name                   String
  address                String
  city                   String
  description            String?
  amenities              String
  images                 String
  status                 String          @default("PENDING_APPROVAL")
  adminNotes             String?
  pgPhotoUrl             String?
  aadhaarProof           String?
  panProof               String?
  pgLicenceUrl           String?
  buildingPhotos         String?
  commonAreaPhotos       String?
  parkingPhotos          String?
  roomsAndBathroomPhotos String?
  livePhotoUrl           String?
  exteriorPhotos         String?
  interiorPhotos         String?
  roomsPhotos            String?
  hallPhotos             String?
  lobbyPhotos            String?
  washroomPhotos         String?
  amenitiesPhotos        String?
  verifiedDocs           String          @default("[]")
  averageRating          Float           @default(0)
  reviewCount            Int             @default(0)
  propertyType           String          @default("PG")
  genderType             String          @default("COED")
  latitude               Float?
  longitude              Float?
  cancellationPolicy     String?
  noticePeriod           Int?
  refundPolicy           String?
  bankAccountNo          String?
  bankIfsc               String?
  bankName               String?
  videoUrl               String?
  isVerified             Boolean         @default(false)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  ownerName              String?
  pgLicence              String?
  licenseNumber          String?
  reraId                 String?
  bookings               Booking[]
  foodMenu               FoodMenu[]
  owner                  User            @relation(fields: [ownerId], references: [id])
  reviews                Review[]
  rooms                  Room[]
  savedBy                SavedProperty[]
  tenants                Tenant[]
  tickets                Ticket[]
}

model Room {
  id           String    @id @default(uuid())
  propertyId   String
  roomNumber   String
  type         String
  price        Float
  availability Int
  photoUrl     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  beds         Bed[]
  bookings     Booking[]
  property     Property  @relation(fields: [propertyId], references: [id])
  tenants      Tenant[]
}

model Bed {
  id                String    @id @default(uuid())
  roomId            String
  bedNumber         String
  status            String    @default("AVAILABLE")
  lockedByBookingId String?
  lockedAt          DateTime?
  lockExpiresAt     DateTime?
  currentBookingId  String?
  tenantId          String?   @unique
  maintenanceReason String?
  maintenanceSince  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  room              Room      @relation(fields: [roomId], references: [id])
  tenant            Tenant?
}

model Booking {
  id                   String           @id @default(uuid())
  displayId            String           @unique
  userId               String
  propertyId           String?
  roomId               String?
  propertyName         String
  occupancy            String
  guestName            String
  guestEmail           String?
  guestPhone           String?
  guestAddress         String?
  onboardingDate       String?
  moveInDate           String
  stayDuration         Int?
  occupants            Int?              @default(1)
  message              String?
  status               String           @default("PENDING_APPROVAL")
  paymentStatus        String           @default("UNPAID")
  paymentMethod        String?
  paidAt               DateTime?
  amount               Float
  roomAssigned         String?
  agreementSigned      Boolean          @default(false)
  agreementSignedAt    DateTime?
  tenantId             String?          @unique
  tokenAmount          Float?           @default(1000)
  tokenPaidAt          DateTime?
  tokenPaymentId       String?
  reservationExpiresAt DateTime?
  kycVerifiedAt        DateTime?
  kycRejectedAt        DateTime?
  kycNotes             String?
  rejectionReason      String?
  cancelReason         String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  deletedAt            DateTime?
  guestCity            String?
  guestCountry         String?          @default("India")
  guestPincode         String?
  occupationDetail     String?
  occupationType       String?
  pendingAmount        Float?
  property             Property?        @relation(fields: [propertyId], references: [id])
  user                 User             @relation(fields: [userId], references: [id])
  room                 Room?            @relation(fields: [roomId], references: [id])
  payments             Payment[]
  platformFee          PlatformFee?
  tenant               Tenant?
  documents            TenantDocument[]
}

model Waitlist {
  id         String    @id @default(uuid())
  userId     String
  propertyId String
  roomType   String?
  occupancy  String?
  guestName  String
  guestPhone String?
  guestEmail String?
  moveInDate String?
  status     String    @default("WAITING")
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Tenant {
  id                  String            @id @default(uuid())
  displayId           String            @unique
  studentId           String
  bookingId           String?           @unique
  propertyId          String
  roomId              String
  bedId               String?           @unique
  name                String
  phone               String
  email               String?
  roomNumber          String
  roomType            String
  rent                Float
  startDate           String
  expectedMoveOutDate String?
  actualMoveOutDate   String?
  status              String            @default("UPCOMING_MOVE_IN")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  vacateNote          String?
  address             String?
  city                String?
  country             String?           @default("India")
  occupationDetail    String?
  occupationType      String?
  pincode             String?
  attendances         Attendance[]
  billingProfile      BillingProfile?
  disputes            Dispute[]
  moveOutRequests     MoveOutRequest[]
  rentRecords         RentRecord[]
  reviews             Review[]
  settlementRecord    SettlementRecord?
  property            Property          @relation(fields: [propertyId], references: [id])
  room                Room              @relation(fields: [roomId], references: [id])
  bed                 Bed?              @relation(fields: [bedId], references: [id])
  booking             Booking?          @relation(fields: [bookingId], references: [id])
}

model BillingProfile {
  id              String           @id @default(uuid())
  tenantId        String           @unique
  propertyId      String
  roomId          String
  bedId           String?
  monthlyRent     Float
  securityDeposit Float
  billingDay      Int              @default(1)
  status          String           @default("ACTIVE")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  invoices        RentInvoice[]
  deposit         SecurityDeposit?
}

model RentInvoice {
  id               String         @id @default(uuid())
  displayId        String         @unique
  billingProfileId String
  tenantId         String
  propertyId       String
  month            String
  amount           Float
  dueDate          DateTime
  status           String         @default("PENDING")
  paidAmount       Float          @default(0)
  paidAt           DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  payments         Payment[]      @relation("InvoicePayments")
  billingProfile   BillingProfile @relation(fields: [billingProfileId], references: [id])
}

model SecurityDeposit {
  id               String         @id @default(uuid())
  billingProfileId String         @unique
  tenantId         String
  amount           Float
  status           String         @default("PENDING")
  paidAt           DateTime?
  refundStatus     String?
  refundAmount     Float?
  deductionAmount  Float?
  deductionReason  String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  payments         Payment[]      @relation("DepositPayments")
  billingProfile   BillingProfile @relation(fields: [billingProfileId], references: [id])
}

model SettlementRecord {
  id               String   @id @default(uuid())
  tenantId         String   @unique
  finalRentPending Float
  utilityCharges   Float    @default(0)
  damageDeductions Float    @default(0)
  depositRefunded  Float
  settlementDate   DateTime @default(now())
  notes            String?
  createdAt        DateTime @default(now())
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
}

model TenantHistory {
  id               String   @id @default(uuid())
  tenantId         String
  studentId        String
  propertyName     String
  roomNumber       String
  bedNumber        String
  moveInDate       DateTime
  moveOutDate      DateTime
  stayDurationDays Int
  totalPaid        Float
  createdAt        DateTime @default(now())
}

model Attendance {
  id         String @id @default(uuid())
  tenantId   String
  propertyId String
  date       String
  status     String @default("PRESENT")
  mealType   String @default("GENERAL")
  tenant     Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, date, mealType])
}

model MoveOutRequest {
  id            String    @id @default(uuid())
  tenantId      String
  requestedBy   String
  requestedDate String
  reason        String?
  status        String    @default("PENDING")
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
}

model Review {
  id         String   @id @default(uuid())
  propertyId String
  tenantId   String
  rating     Int
  comment    String?
  status     String   @default("PUBLISHED")
  adminNotes String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  property   Property @relation(fields: [propertyId], references: [id])

  @@unique([propertyId, tenantId])
}

model RentRecord {
  id        String   @id @default(uuid())
  tenantId  String
  month     String
  amount    Float
  paid      Boolean  @default(false)
  paidOn    String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
}

model Payment {
  id              String           @id @default(uuid())
  bookingId       String
  invoiceId       String?
  depositId       String?
  amount          Float
  method          String
  status          String           @default("PENDING")
  razorpayOrderId String?
  razorpayId      String?
  verifiedBy      String?
  date            DateTime         @default(now())
  deposit         SecurityDeposit? @relation("DepositPayments", fields: [depositId], references: [id])
  invoice         RentInvoice?     @relation("InvoicePayments", fields: [invoiceId], references: [id])
  booking         Booking          @relation(fields: [bookingId], references: [id])
}

model FoodMenu {
  id         String   @id @default(uuid())
  propertyId String
  dayOfWeek  String
  mealType   String
  items      String
  property   Property @relation(fields: [propertyId], references: [id])
}

model Ticket {
  id           String    @id @default(uuid())
  displayId    String    @unique
  userId       String
  propertyId   String?
  category     String
  status       String    @default("OPEN")
  priority     String    @default("MEDIUM")
  assignedTo   String?
  targetTeam   String    @default("ADMIN")
  raisedByRole String    @default("USER")
  description  String
  replies      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id])
  property     Property? @relation(fields: [propertyId], references: [id])
}

model Notification {
  id             String   @id @default(uuid())
  userId         String
  type           String
  category       String?
  message        String
  isRead         Boolean  @default(false)
  isPersistent   Boolean  @default(false)
  targetRole     String   @default("USER")
  metadata       String?
  recipientEmail String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  targetId    String
  targetType  String?
  details     String?
  performedBy String
  timestamp   DateTime @default(now())
  performer   User     @relation("PerformedBy", fields: [performedBy], references: [id])
}

model ActionNote {
  id           String   @id @default(uuid())
  targetUserId String?
  targetType   String
  targetId     String
  action       String
  reason       String
  performedBy  String
  timestamp    DateTime @default(now())
  targetUser   User?    @relation("TargetUser", fields: [targetUserId], references: [id])
}

model TenantDocument {
  id           String    @id @default(uuid())
  bookingId    String
  type         String
  fileData     String
  fileName     String?
  status       String    @default("PENDING")
  rejectedNote String?
  uploadedAt   DateTime  @default(now())
  verifiedAt   DateTime?
  verifiedBy   String?
  auditTrail   String    @default("[]")
  booking      Booking   @relation(fields: [bookingId], references: [id])
}

model TeamMember {
  id          String   @id @default(uuid())
  displayId   String   @unique
  name        String
  email       String
  phone       String?
  role        String
  permissions String
  status      String   @default("ACTIVE")
  addedOn     DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OwnerStaff {
  id           String   @id @default(uuid())
  displayId    String   @unique
  ownerId      String
  name         String
  email        String
  phone        String?
  designation  String
  permissions  String
  status       String   @default("ACTIVE")
  addedOn      DateTime @default(now())
  updatedAt    DateTime @updatedAt
  addressProof String?
  idProof      String?
  photo        String?
  staffAddress String?
}

model PlatformSettings {
  id                       String   @id @default("singleton")
  feesEnabled              Boolean  @default(false)
  studentRentFeeFlat       Float    @default(9)
  ownerRentFeeFlat         Float    @default(9)
  ownerOnboardingFeeFlat   Float    @default(99)
  platformWalletBalance    Float    @default(0)
  globalCommissionRate     Float    @default(10)
  kycRequired              Boolean  @default(true)
  tokenPaymentRequired     Boolean  @default(true)
  maxBookingsPerStudentDay Int      @default(3)
  maxListingsPerOwnerDay   Int      @default(3)
  reservationWindowMins    Int      @default(10)
  maintenanceMode          Boolean  @default(false)
  maintenanceMessage       String?
  updatedAt                DateTime @updatedAt
}

model PlatformFee {
  id             String   @id @default(uuid())
  bookingId      String   @unique
  grossAmount    Float
  customerFee    Float
  totalCharged   Float
  ownerNet       Float
  ownerFee       Float
  platformEarned Float
  createdAt      DateTime @default(now())
  booking        Booking  @relation(fields: [bookingId], references: [id])
}

model FeeExemption {
  id             String   @id @default(uuid())
  userId         String?
  propertyName   String?
  exemptCustomer Boolean  @default(false)
  exemptOwner    Boolean  @default(false)
  reason         String
  createdAt      DateTime @default(now())
}

model OwnerOnboarding {
  id                String    @id @default(uuid())
  displayId         String    @unique
  source            String
  ownerName         String
  ownerEmail        String
  ownerPhone        String
  buildingName      String
  address           String
  city              String
  pincode           String
  country           String    @default("India")
  pgLicenceNumber   String?
  notes             String?
  idProofData       String?
  idProofName       String?
  pgLicenceData     String?
  pgLicenceName     String?
  buildingImageData String?
  buildingImageName String?
  additionalPhotos  String    @default("[]")
  status            String    @default("PENDING_ONBOARDING")
  submittedById     String?
  onboardedById     String?
  verifiedById      String?
  onboardedAt       DateTime?
  verifiedAt        DateTime?
  rejectedReason    String?
  auditTrail        String    @default("[]")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  onboardedBy       User?     @relation("OnboardedBy", fields: [onboardedById], references: [id])
}

model Employee {
  id                     String    @id @default(uuid())
  displayId              String    @unique
  name                   String
  email                  String    @unique
  phone                  String
  dateOfBirth            String?
  gender                 String?
  permanentAddress       String?
  currentAddress         String?
  emergencyContactName   String?
  emergencyContactPhone  String?
  emergencyContactRel    String?
  department             String
  designation            String
  permissions            String    @default("[]")
  joiningDate            DateTime?
  salary                 Float?
  employmentType         String    @default("FULL_TIME")
  aadhaarNumber          String?
  aadhaarDoc             String?
  aadhaarName            String?
  panNumber              String?
  panDoc                 String?
  panName                String?
  photo                  String?
  photoName              String?
  educationCert          String?
  educationCertName      String?
  experienceLetter       String?
  experienceLetterName   String?
  policeVerification     String?
  policeVerificationName String?
  addressProof           String?
  addressProofName       String?
  aadhaarVerified        Boolean   @default(false)
  panVerified            Boolean   @default(false)
  educationVerified      Boolean   @default(false)
  addressVerified        Boolean   @default(false)
  policeVerified         Boolean   @default(false)
  backgroundCheckStatus  String    @default("PENDING")
  backgroundCheckNotes   String?
  backgroundCheckedAt    DateTime?
  status                 String    @default("PENDING_DOCS")
  rejectedReason         String?
  suspensionReason       String?
  terminatedReason       String?
  auditTrail             String    @default("[]")
  addedById              String?
  addedOn                DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  empCode                String?   @unique
  empCodeNotes           String?
}

model OwnerPayout {
  id               String    @id @default(uuid())
  displayId        String    @unique
  ownerId          String
  propertyId       String?
  period           String
  grossAmount      Float
  commissionAmount Float
  netAmount        Float
  bookingIds       String    @default("[]")
  status           String    @default("PENDING")
  paymentMode      String?
  bankAccountNo    String?
  bankIfsc         String?
  txnReference     String?
  notes            String?
  scheduledFor     DateTime?
  paidAt           DateTime?
  approvedBy       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Dispute {
  id           String    @id @default(uuid())
  displayId    String    @unique
  tenantId     String?
  bookingId    String?
  raisedById   String
  raisedByRole String    @default("USER")
  type         String
  subject      String
  description  String
  evidenceData String?
  evidenceName String?
  status       String    @default("OPEN")
  priority     String    @default("MEDIUM")
  resolution   String?
  resolvedById String?
  resolvedAt   DateTime?
  adminNotes   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tenant       Tenant?   @relation(fields: [tenantId], references: [id])
}

model BookingEvent {
  id              String   @id @default(uuid())
  bookingId       String
  eventType       String
  title           String
  description     String?
  performedBy     String?
  performedByRole String?
  metadata        String   @default("{}")
  createdAt       DateTime @default(now())
}

model FraudAlert {
  id             String   @id @default(uuid())
  userId         String
  type           String
  severity       String   @default("MEDIUM")
  targetId       String
  targetType     String
  description    String
  metadata       String   @default("{}")
  status         String   @default("OPEN")
  investigatedBy String?
  resolution     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id])
}

model SystemEvent {
  id        String   @id @default(uuid())
  type      String
  severity  String   @default("INFO")
  message   String
  userId    String?
  ipAddress String?
  path      String?
  metadata  String   @default("{}")
  createdAt DateTime @default(now())
}

model LoginLog {
  id         String   @id @default(uuid())
  userId     String
  userRole   String
  adminRole  String?
  success    Boolean
  ipAddress  String?
  userAgent  String?
  failReason String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model RateLimit {
  id          String   @id @default(uuid())
  key         String   @unique
  action      String
  count       Int      @default(1)
  windowStart DateTime @default(now())
  windowEnd   DateTime
  updatedAt   DateTime @updatedAt
}

model AdminPermission {
  id         String   @id @default(uuid())
  adminId    String
  permission String
  granted    Boolean  @default(true)
  grantedBy  String?
  reason     String?
  createdAt  DateTime @default(now())
}

model SavedProperty {
  id         String   @id @default(uuid())
  userId     String
  propertyId String
  note       String?
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, propertyId])
}

model Message {
  id                String    @id @default(uuid())
  bookingId         String?
  propertyId        String?
  threadId          String
  senderId          String
  receiverId        String
  content           String
  attachmentData    String?
  attachmentName    String?
  isRead            Boolean   @default(false)
  readAt            DateTime?
  deletedBySender   Boolean   @default(false)
  deletedByReceiver Boolean   @default(false)
  createdAt         DateTime  @default(now())
  receiver          User      @relation("ReceivedMessages", fields: [receiverId], references: [id])
  sender            User      @relation("SentMessages", fields: [senderId], references: [id])
}

model UserSession {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  ipAddress  String?
  userAgent  String?
  isActive   Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model RefundRecord {
  id           String    @id @default(uuid())
  bookingId    String
  amount       Float
  reason       String
  refundType   String    @default("PARTIAL")
  status       String    @default("PENDING")
  initiatedBy  String
  initiatedAt  DateTime  @default(now())
  processedAt  DateTime?
  processedBy  String?
  txnReference String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

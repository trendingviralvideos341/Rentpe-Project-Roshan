generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("RENTPE_DATABASE_URL")
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  role             String            @default("USER")
  roles            String            @default("USER") // Comma-separated list of assigned roles
  isStudent        Boolean           @default(false)
  isOwner          Boolean           @default(false)
  isAdmin          Boolean           @default(false)
  isOnboarder      Boolean           @default(false)
  isVerifier       Boolean           @default(false)
  name             String?
  phone            String?
  status           String            @default("ACTIVE")
  lastLoginAt      DateTime?         @default(now())
  lastLoginIp      String?
  bannedReason     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  displayId        String?           @unique
  deletedAt        DateTime?
  razorpayAccountId String?
  resetToken       String?
  resetTokenExpiry DateTime?
  actionNotes      ActionNote[]      @relation("TargetUser")
  auditLogs        AuditLog[]        @relation("PerformedBy")
  bookings         Booking[]
  notifications    Notification[]
  ownerOnboardings OwnerOnboarding[] @relation("OnboardedBy")
  properties       Property[]
  tickets          Ticket[]
}

model Property {
  id          String     @id @default(uuid())
  ownerId     String
  name        String
  address     String
  city        String
  description String?
  amenities   String
  images      String
  // PENDING_APPROVAL, PAYMENT_PENDING, LIVE, REJECTED, SUSPENDED
  status      String     @default("PENDING_APPROVAL")
  adminNotes  String?
  pgPhotoUrl  String?
  aadhaarProof String?
  panProof     String?
  pgLicenceUrl String?
  buildingPhotos String?
  commonAreaPhotos String?
  parkingPhoto String?
  bathroomPhoto String?
  livePhotoUrl  String?
  verifiedDocs  String    @default("[]")
  averageRating Float     @default(0)
  reviewCount   Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt   DateTime   @updatedAt
  ownerName   String?
  pgLicence   String?
  foodMenu    FoodMenu[]
  owner       User       @relation(fields: [ownerId], references: [id])
  rooms       Room[]
  bookings    Booking[]
  tenants     Tenant[]
  tickets     Ticket[]
  reviews     Review[]
}

model Room {
  id           String    @id @default(uuid())
  propertyId   String
  roomNumber   String
  type         String
  price        Float
  availability Int
  photoUrl     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bookings     Booking[]
  property     Property  @relation(fields: [propertyId], references: [id])
  tenants      Tenant[]
}

model Booking {
  id               String           @id @default(uuid())
  displayId        String           @unique
  userId           String
  propertyId       String?
  roomId           String?
  propertyName     String
  occupancy        String
  guestName        String
  guestEmail       String?
  guestPhone       String?
  guestAddress     String?
  onboardingDate   String?
  moveInDate       String
  // Status: PENDING_APPROVAL | APPROVED_PENDING_TOKEN | TOKEN_PAID | ROOM_RESERVED
  //         KYC_PENDING | KYC_VERIFIED | KYC_FAILED | AGREEMENT_PENDING
  //         BOOKING_CONFIRMED | CHECKED_IN | WAITLISTED | REJECTED | CANCELLED | EXPIRED
  //         (Legacy: APPROVED_KYC_PENDING, APPROVED_PAYMENT_PENDING, PAID, CASH_PAID)
  status           String           @default("PENDING_APPROVAL")
  paymentStatus    String           @default("UNPAID")
  paymentMethod    String?
  paidAt           DateTime?
  amount           String
  roomAssigned     String?
  agreementSigned  Boolean          @default(false)
  agreementSignedAt DateTime?
  tenantId         String?          @unique
  // Token payment fields
  tokenAmount      Float?           @default(1000)
  tokenPaidAt      DateTime?
  tokenPaymentId   String?
  reservationExpiresAt DateTime?
  // KYC fields
  kycVerifiedAt    DateTime?
  kycRejectedAt    DateTime?
  kycNotes         String?
  // Rejection / cancellation
  rejectionReason  String?
  cancelReason     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  guestCity        String?
  guestCountry     String?          @default("India")
  guestPincode     String?
  occupationDetail String?
  occupationType   String?
  pendingAmount    String?
  room             Room?            @relation(fields: [roomId], references: [id])
  user             User             @relation(fields: [userId], references: [id])
  property         Property?        @relation(fields: [propertyId], references: [id])
  payments         Payment[]
  platformFee      PlatformFee?
  documents        TenantDocument[]
}

model Waitlist {
  id           String   @id @default(uuid())
  userId       String
  propertyId   String
  roomType     String?
  occupancy    String?
  guestName    String
  guestPhone   String?
  guestEmail   String?
  moveInDate   String?
  status       String   @default("WAITING") // WAITING | NOTIFIED | CONVERTED | CANCELLED
  notifiedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Tenant {
  id               String       @id @default(uuid())
  displayId        String       @unique
  name             String
  phone            String
  email            String?
  propertyId       String
  roomId           String
  roomNumber       String
  roomType         String
  rent             String
  startDate        String
  status           String       @default("ACTIVE")
  vacatedOn        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  vacateNote       String?
  address          String?
  city             String?
  country          String?      @default("India")
  occupationDetail String?
  occupationType   String?
  pincode          String?
  rentRecords      RentRecord[]
  room             Room         @relation(fields: [roomId], references: [id])
  property         Property     @relation(fields: [propertyId], references: [id])
  reviews          Review[]
}

model Review {
  id           String   @id @default(uuid())
  propertyId   String
  tenantId     String
  rating       Int      // 1 to 5
  comment      String?
  status       String   @default("PUBLISHED") // PUBLISHED, HIDDEN, FLAGGED
  adminNotes   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  property     Property @relation(fields: [propertyId], references: [id])
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([propertyId, tenantId]) // A tenant can only review a property once
}

model RentRecord {
  id        String   @id @default(uuid())
  tenantId  String
  month     String
  amount    String
  paid      Boolean  @default(false)
  paidOn    String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
}

model Payment {
  id              String   @id @default(uuid())
  bookingId       String
  amount          Float
  method          String
  status          String   @default("PENDING")
  razorpayOrderId String?
  razorpayId      String?
  verifiedBy      String?
  date            DateTime @default(now())
  booking         Booking  @relation(fields: [bookingId], references: [id])
}

model FoodMenu {
  id         String   @id @default(uuid())
  propertyId String
  dayOfWeek  String
  mealType   String
  items      String
  property   Property @relation(fields: [propertyId], references: [id])
}

model Ticket {
  id           String    @id @default(uuid())
  displayId    String    @unique
  userId       String
  propertyId   String?
  category     String
  status       String    @default("OPEN")
  priority     String    @default("MEDIUM")
  assignedTo   String?
  targetTeam   String    @default("ADMIN")
  raisedByRole String    @default("USER")
  description  String
  replies      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  property     Property? @relation(fields: [propertyId], references: [id])
  user         User      @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  targetId    String
  targetType  String?
  details     String?
  performedBy String
  timestamp   DateTime @default(now())
  performer   User     @relation("PerformedBy", fields: [performedBy], references: [id])
}

model ActionNote {
  id           String   @id @default(uuid())
  targetUserId String?
  targetType   String
  targetId     String
  action       String
  reason       String
  performedBy  String
  timestamp    DateTime @default(now())
  targetUser   User?    @relation("TargetUser", fields: [targetUserId], references: [id])
}

model TenantDocument {
  id           String    @id @default(uuid())
  bookingId    String
  type         String
  fileData     String
  fileName     String?
  status       String    @default("PENDING")
  rejectedNote String?
  uploadedAt   DateTime  @default(now())
  verifiedAt   DateTime?
  verifiedBy   String?
  auditTrail   String    @default("[]")
  booking      Booking   @relation(fields: [bookingId], references: [id])
}

model TeamMember {
  id          String   @id @default(uuid())
  displayId   String   @unique
  name        String
  email       String
  phone       String?
  role        String
  permissions String
  status      String   @default("ACTIVE")
  addedOn     DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OwnerStaff {
  id           String   @id @default(uuid())
  displayId    String   @unique
  ownerId      String
  name         String
  email        String
  phone        String?
  designation  String
  permissions  String
  status       String   @default("ACTIVE")
  addedOn      DateTime @default(now())
  updatedAt    DateTime @updatedAt
  addressProof String?
  idProof      String?
  photo        String?
  staffAddress String?
}

model PlatformSettings {
  id                    String   @id @default("singleton")
  feesEnabled           Boolean  @default(false)
  studentRentFeeFlat    Float    @default(9)
  ownerRentFeeFlat      Float    @default(9)
  ownerOnboardingFeeFlat Float   @default(99)
  platformWalletBalance Float    @default(0)
  updatedAt             DateTime @updatedAt
}

model PlatformFee {
  id             String   @id @default(uuid())
  bookingId      String   @unique
  grossAmount    Float
  customerFee    Float
  totalCharged   Float
  ownerNet       Float
  ownerFee       Float
  platformEarned Float
  createdAt      DateTime @default(now())
  booking        Booking  @relation(fields: [bookingId], references: [id])
}

model FeeExemption {
  id             String   @id @default(uuid())
  userId         String?
  propertyName   String?
  exemptCustomer Boolean  @default(false)
  exemptOwner    Boolean  @default(false)
  reason         String
  createdAt      DateTime @default(now())
}

model OwnerOnboarding {
  id                String    @id @default(uuid())
  displayId         String    @unique
  source            String
  ownerName         String
  ownerEmail        String
  ownerPhone        String
  buildingName      String
  address           String
  city              String
  pincode           String
  country           String    @default("India")
  pgLicenceNumber   String?
  notes             String?
  idProofData       String?
  idProofName       String?
  pgLicenceData     String?
  pgLicenceName     String?
  buildingImageData String?
  buildingImageName String?
  additionalPhotos  String    @default("[]")
  status            String    @default("PENDING_ONBOARDING")
  submittedById     String?
  onboardedById     String?
  verifiedById      String?
  onboardedAt       DateTime?
  verifiedAt        DateTime?
  rejectedReason    String?
  auditTrail        String    @default("[]")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  onboardedBy       User?     @relation("OnboardedBy", fields: [onboardedById], references: [id])
}

model Employee {
  id                     String    @id @default(uuid())
  displayId              String    @unique
  name                   String
  email                  String    @unique
  phone                  String
  dateOfBirth            String?
  gender                 String?
  permanentAddress       String?
  currentAddress         String?
  emergencyContactName   String?
  emergencyContactPhone  String?
  emergencyContactRel    String?
  department             String
  designation            String
  permissions            String    @default("[]")
  joiningDate            DateTime?
  salary                 Float?
  employmentType         String    @default("FULL_TIME")
  aadhaarNumber          String?
  aadhaarDoc             String?
  aadhaarName            String?
  panNumber              String?
  panDoc                 String?
  panName                String?
  photo                  String?
  photoName              String?
  educationCert          String?
  educationCertName      String?
  experienceLetter       String?
  experienceLetterName   String?
  policeVerification     String?
  policeVerificationName String?
  addressProof           String?
  addressProofName       String?
  aadhaarVerified        Boolean   @default(false)
  panVerified            Boolean   @default(false)
  educationVerified      Boolean   @default(false)
  addressVerified        Boolean   @default(false)
  policeVerified         Boolean   @default(false)
  backgroundCheckStatus  String    @default("PENDING")
  backgroundCheckNotes   String?
  backgroundCheckedAt    DateTime?
  status                 String    @default("PENDING_DOCS")
  rejectedReason         String?
  suspensionReason       String?
  terminatedReason       String?
  auditTrail             String    @default("[]")
  addedById              String?
  addedOn                DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  empCode                String?   @unique
  empCodeNotes           String?
}

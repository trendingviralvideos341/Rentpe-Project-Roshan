generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("RENTPE_DATABASE_URL")
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  role             String            @default("USER")
  name             String?
  phone            String?
  status           String            @default("ACTIVE")
  bannedReason     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  displayId        String?           @unique
  deletedAt        DateTime?
  actionNotes      ActionNote[]      @relation("TargetUser")
  auditLogs        AuditLog[]        @relation("PerformedBy")
  bookings         Booking[]
  notifications    Notification[]
  ownerOnboardings OwnerOnboarding[] @relation("OnboardedBy")
  properties       Property[]
  tickets          Ticket[]
}

model Property {
  id          String     @id @default(uuid())
  ownerId     String
  name        String
  address     String
  city        String
  description String?
  amenities   String
  images      String
  status      String     @default("PENDING_APPROVAL")
  adminNotes  String?
  pgPhotoUrl  String?
  aadhaarProof String?
  panProof     String?
  pgLicenceUrl String?
  buildingPhotos String?
  commonAreaPhotos String?
  parkingPhoto String?
  bathroomPhoto String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  ownerName   String?
  pgLicence   String?
  foodMenu    FoodMenu[]
  owner       User       @relation(fields: [ownerId], references: [id])
  rooms       Room[]
  tenants     Tenant[]
  tickets     Ticket[]
}

model Room {
  id           String    @id @default(uuid())
  propertyId   String
  roomNumber   String
  type         String
  price        Float
  availability Int
  photoUrl     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bookings     Booking[]
  property     Property  @relation(fields: [propertyId], references: [id])
  tenants      Tenant[]
}

model Booking {
  id               String           @id @default(uuid())
  displayId        String           @unique
  userId           String
  roomId           String?
  propertyName     String
  occupancy        String
  guestName        String
  guestEmail       String?
  guestPhone       String?
  guestAddress     String?
  onboardingDate   String?
  moveInDate       String
  status           String           @default("PENDING_APPROVAL")
  paymentStatus    String           @default("UNPAID")
  paymentMethod    String?
  paidAt           DateTime?
  amount           String
  roomAssigned     String?
  agreementSigned  Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  guestCity        String?
  guestCountry     String?          @default("India")
  guestPincode     String?
  occupationDetail String?
  occupationType   String?
  pendingAmount    String?
  room             Room?            @relation(fields: [roomId], references: [id])
  user             User             @relation(fields: [userId], references: [id])
  payments         Payment[]
  platformFee      PlatformFee?
  documents        TenantDocument[]
}

model Tenant {
  id               String       @id @default(uuid())
  displayId        String       @unique
  name             String
  phone            String
  email            String?
  propertyId       String
  roomId           String
  roomNumber       String
  roomType         String
  rent             String
  startDate        String
  status           String       @default("ACTIVE")
  vacatedOn        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  vacateNote       String?
  address          String?
  city             String?
  country          String?      @default("India")
  occupationDetail String?
  occupationType   String?
  pincode          String?
  rentRecords      RentRecord[]
  room             Room         @relation(fields: [roomId], references: [id])
  property         Property     @relation(fields: [propertyId], references: [id])
}

model RentRecord {
  id        String   @id @default(uuid())
  tenantId  String
  month     String
  amount    String
  paid      Boolean  @default(false)
  paidOn    String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
}

model Payment {
  id              String   @id @default(uuid())
  bookingId       String
  amount          Float
  method          String
  status          String   @default("PENDING")
  razorpayOrderId String?
  razorpayId      String?
  verifiedBy      String?
  date            DateTime @default(now())
  booking         Booking  @relation(fields: [bookingId], references: [id])
}

model FoodMenu {
  id         String   @id @default(uuid())
  propertyId String
  dayOfWeek  String
  mealType   String
  items      String
  property   Property @relation(fields: [propertyId], references: [id])
}

model Ticket {
  id          String    @id @default(uuid())
  displayId   String    @unique
  userId      String
  propertyId  String?
  category    String
  status      String    @default("OPEN")
  priority    String    @default("MEDIUM")
  assignedTo  String?
  description String
  replies     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  property    Property? @relation(fields: [propertyId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  targetId    String
  targetType  String?
  details     String?
  performedBy String
  timestamp   DateTime @default(now())
  performer   User     @relation("PerformedBy", fields: [performedBy], references: [id])
}

model ActionNote {
  id           String   @id @default(uuid())
  targetUserId String?
  targetType   String
  targetId     String
  action       String
  reason       String
  performedBy  String
  timestamp    DateTime @default(now())
  targetUser   User?    @relation("TargetUser", fields: [targetUserId], references: [id])
}

model TenantDocument {
  id           String    @id @default(uuid())
  bookingId    String
  type         String
  fileData     String
  fileName     String?
  status       String    @default("PENDING")
  rejectedNote String?
  uploadedAt   DateTime  @default(now())
  verifiedAt   DateTime?
  verifiedBy   String?
  booking      Booking   @relation(fields: [bookingId], references: [id])
}

model TeamMember {
  id          String   @id @default(uuid())
  displayId   String   @unique
  name        String
  email       String
  phone       String?
  role        String
  permissions String
  status      String   @default("ACTIVE")
  addedOn     DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OwnerStaff {
  id           String   @id @default(uuid())
  displayId    String   @unique
  ownerId      String
  name         String
  email        String
  phone        String?
  designation  String
  permissions  String
  status       String   @default("ACTIVE")
  addedOn      DateTime @default(now())
  updatedAt    DateTime @updatedAt
  addressProof String?
  idProof      String?
  photo        String?
  staffAddress String?
}

model PlatformSettings {
  id                    String   @id @default("singleton")
  feesEnabled           Boolean  @default(false)
  customerFeeFlat       Float    @default(10)
  customerFeePercent    Float    @default(0.09)
  ownerFeeFlat          Float    @default(10)
  ownerFeePercent       Float    @default(0.10)
  platformWalletBalance Float    @default(0)
  updatedAt             DateTime @updatedAt
}

model PlatformFee {
  id             String   @id @default(uuid())
  bookingId      String   @unique
  grossAmount    Float
  customerFee    Float
  totalCharged   Float
  ownerNet       Float
  ownerFee       Float
  platformEarned Float
  createdAt      DateTime @default(now())
  booking        Booking  @relation(fields: [bookingId], references: [id])
}

model FeeExemption {
  id             String   @id @default(uuid())
  userId         String?
  propertyName   String?
  exemptCustomer Boolean  @default(false)
  exemptOwner    Boolean  @default(false)
  reason         String
  createdAt      DateTime @default(now())
}

model OwnerOnboarding {
  id                String    @id @default(uuid())
  displayId         String    @unique
  source            String
  ownerName         String
  ownerEmail        String
  ownerPhone        String
  buildingName      String
  address           String
  city              String
  pincode           String
  country           String    @default("India")
  pgLicenceNumber   String?
  notes             String?
  idProofData       String?
  idProofName       String?
  pgLicenceData     String?
  pgLicenceName     String?
  buildingImageData String?
  buildingImageName String?
  additionalPhotos  String    @default("[]")
  status            String    @default("PENDING_ONBOARDING")
  submittedById     String?
  onboardedById     String?
  verifiedById      String?
  onboardedAt       DateTime?
  verifiedAt        DateTime?
  rejectedReason    String?
  auditTrail        String    @default("[]")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  onboardedBy       User?     @relation("OnboardedBy", fields: [onboardedById], references: [id])
}

model Employee {
  id                     String    @id @default(uuid())
  displayId              String    @unique
  name                   String
  email                  String    @unique
  phone                  String
  dateOfBirth            String?
  gender                 String?
  permanentAddress       String?
  currentAddress         String?
  emergencyContactName   String?
  emergencyContactPhone  String?
  emergencyContactRel    String?
  department             String
  designation            String
  permissions            String    @default("[]")
  joiningDate            DateTime?
  salary                 Float?
  employmentType         String    @default("FULL_TIME")
  aadhaarNumber          String?
  aadhaarDoc             String?
  aadhaarName            String?
  panNumber              String?
  panDoc                 String?
  panName                String?
  photo                  String?
  photoName              String?
  educationCert          String?
  educationCertName      String?
  experienceLetter       String?
  experienceLetterName   String?
  policeVerification     String?
  policeVerificationName String?
  addressProof           String?
  addressProofName       String?
  aadhaarVerified        Boolean   @default(false)
  panVerified            Boolean   @default(false)
  educationVerified      Boolean   @default(false)
  addressVerified        Boolean   @default(false)
  policeVerified         Boolean   @default(false)
  backgroundCheckStatus  String    @default("PENDING")
  backgroundCheckNotes   String?
  backgroundCheckedAt    DateTime?
  status                 String    @default("PENDING_DOCS")
  rejectedReason         String?
  suspensionReason       String?
  terminatedReason       String?
  auditTrail             String    @default("[]")
  addedById              String?
  addedOn                DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  empCode                String?   @unique
  empCodeNotes           String?
}
